---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { sortByDateDesc } from "../../utils/content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content, headings } = await render(post);

const posts = sortByDateDesc(await getCollection("blog"));
const index = posts.findIndex((entry) => entry.id === post.id);
const prevPost = index > 0
  ? { id: posts[index - 1].id, title: posts[index - 1].data.title, pubDate: posts[index - 1].data.pubDate }
  : undefined;
const nextPost = index >= 0 && index < posts.length - 1
  ? { id: posts[index + 1].id, title: posts[index + 1].data.title, pubDate: posts[index + 1].data.pubDate }
  : undefined;

// 相关文章：同专题权重更高，其次看共同标签数量，最后按发布时间新到旧。
const currentTags = new Set(post.data.tags ?? []);
const relatedPosts = posts
  .filter((entry) => entry.id !== post.id)
  .map((entry) => {
    const sharedTags = (entry.data.tags ?? []).filter((tag) => currentTags.has(tag)).length;
    const sameCollection = post.data.collection && entry.data.collection === post.data.collection ? 1 : 0;
    return { entry, score: sameCollection * 2 + sharedTags };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score || b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf())
  .slice(0, 3)
  .map((item) => item.entry);
---

<BlogPost
  {...post.data}
  body={post.body ?? ""}
  headings={headings}
  enableComments={post.data.enableComments ?? true}
  prevPost={prevPost}
  nextPost={nextPost}
  relatedPosts={relatedPosts}
>
  <Content />
</BlogPost>
