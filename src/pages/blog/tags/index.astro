---
import { getCollection } from "astro:content";
import FormattedDate from "../../../components/FormattedDate.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Box from "../../../components/layout/Box.astro";
import Cell from "../../../components/layout/Cell.astro";
import { PAGE_COPY, SITE_TITLE } from "../../../consts";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getTagSummaries, tagPath } from "../../../utils/content";
import { withBase } from "../../../utils/withBase";

const tags = getTagSummaries(await getCollection("blog"));
---

<SiteLayout title={`${PAGE_COPY.tags.title} | ${SITE_TITLE}`} description={PAGE_COPY.tags.description}>
  <PageHeader title={PAGE_COPY.tags.title} description={PAGE_COPY.tags.description} descriptionItalic={PAGE_COPY.tags.descriptionItalic} count={{ value: tags.length, unit: "个" }} />
  <Box>
    {tags.length > 0 ? (
      <Cell>
        <ol class="columns-1 gap-6 sm:columns-2 md:columns-3">
          {tags.map(([tag, meta], index) => (
            <li class="break-inside-avoid">
              <a class="grid grid-cols-[2ch_minmax(0,1fr)_auto] items-center gap-2 py-2 text-heading no-underline hover:text-accent" href={withBase(tagPath(tag))}>
                <span class="text-label tabular-nums text-subtle" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span class="min-w-0">
                  <strong class="block truncate text-card font-bold">{tag}</strong>
                  <span class="mt-0.5 block text-label font-normal text-subtle">最近 <FormattedDate date={meta.latest} /></span>
                </span>
                <small class="text-label whitespace-nowrap text-subtle">{meta.count} 篇</small>
              </a>
            </li>
          ))}
        </ol>
      </Cell>
    ) : (
      <Cell>
        <p class="text-body text-subtle">还没有标签。写文章时在 Frontmatter 里加上 tags，这里会自动汇总。</p>
      </Cell>
    )}
  </Box>
</SiteLayout>
