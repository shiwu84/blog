---
import { getCollection } from "astro:content";
import FormattedDate from "../../../components/FormattedDate.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PostList from "../../../components/PostList.astro";
import Box from "../../../components/layout/Box.astro";
import { SITE_TITLE } from "../../../consts";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { sortByDateDesc, taxonomySlug } from "../../../utils/content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const tags = new Set(posts.flatMap((post) => post.data.tags ?? []));
  return Array.from(tags).map((tag) => ({ params: { slug: taxonomySlug(tag) }, props: { tagName: tag } }));
}

const { tagName } = Astro.props;
const posts = sortByDateDesc((await getCollection("blog")).filter((post) => (post.data.tags ?? []).includes(tagName)));
const description = `与「${tagName}」相关的文章。`;
const latest = posts[0]?.data.pubDate;
---

<SiteLayout title={`${tagName} | 标签 | ${SITE_TITLE}`} description={description}>
  <PageHeader title={tagName} description={description} count={{ value: posts.length, unit: "篇" }}>
    <Fragment slot="description">
      {description}
      {latest && <span class="text-subtle"> · 最近更新 <FormattedDate date={latest} /></span>}
    </Fragment>
  </PageHeader>
  <Box><PostList posts={posts} showDescription={false} /></Box>
</SiteLayout>
