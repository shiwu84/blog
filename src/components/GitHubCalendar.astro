---
import GitHubContributionGrid from "./GitHubContributionGrid.astro";

interface Props {
  contributions: Array<{ date: string; count: number; level: number }>;
  totalCount: number;
  recentContributions: Array<{ date: string; count: number; level: number }>;
  recentTotalCount: number;
}

const { contributions, totalCount, recentContributions, recentTotalCount } = Astro.props;
---

{/* 桌面/平板横屏：完整一年 */}
<div class="hidden md:block">
  <GitHubContributionGrid days={contributions} totalCount={totalCount} />
</div>

{/* 手机：最近半年（格子更大、更清晰） */}
<div class="md:hidden">
  <GitHubContributionGrid days={recentContributions} totalCount={recentTotalCount} />
</div>
