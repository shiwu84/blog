---
import type { MarkdownHeading } from "astro";
import Cell from "./layout/Cell.astro";

interface Props {
  headings: MarkdownHeading[];
  variant?: "sidebar" | "inline";
}

const { headings, variant = "sidebar" } = Astro.props;
// 只把 h2/h3 收进目录；太短的页面不显示目录。
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = items.length >= 3;
const tocLabel = `${items.length} 节`;
---

{
  showToc && variant === "sidebar" && (
    <nav class="toc-sidebar" aria-label="文章目录" data-toc>
      <p class="toc-title">目录</p>
      <ol class="toc-list">
        {items.map((heading) => (
          <li class:list={["toc-item", heading.depth === 3 && "toc-item-sub"]}>
            <a data-toc-link href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

{
  showToc && variant === "inline" && (
    <Cell class="min-[80rem]:hidden" data-toc-inline-cell>
      <details class="toc-inline" data-toc-inline>
        <summary>
          <span class="toc-inline-label">目录</span>
          <span class="toc-inline-count">{tocLabel}</span>
          <svg class="toc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <ol class="toc-list">
          {items.map((heading) => (
            <li class:list={["toc-item", heading.depth === 3 && "toc-item-sub"]}>
              <a data-toc-link href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </details>
    </Cell>
  )
}

<style>
  .toc-sidebar {
    --toc-width: 11.25rem;
    position: fixed;
    top: calc(var(--spacing-bar) + 2.25rem);
    left: max(1rem, calc(50vw - var(--container-page) / 2 - var(--toc-width) - 1rem));
    z-index: 20;
    width: var(--toc-width);
    max-height: calc(100dvh - 7.5rem);
    overflow-y: auto;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-box);
    background-color: color-mix(in srgb, var(--color-surface) 74%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    scrollbar-width: thin;
  }

  .toc-sidebar[hidden] {
    display: none;
  }

  @media (max-width: 79.9375rem) {
    .toc-sidebar {
      display: none;
    }
  }

  .toc-title {
    margin: 0 0 0.55rem;
    padding-left: 0.55rem;
    color: var(--color-subtle);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .toc-list {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-item a {
    display: block;
    padding: 0.24rem 0 0.24rem 0.55rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-subtle);
    font-size: 0.8125rem;
    line-height: 1.45;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .toc-item-sub a {
    padding-left: 1.15rem;
    font-size: 0.75rem;
  }

  .toc-item a:hover {
    color: var(--color-accent);
  }

  .toc-item a[aria-current] {
    border-left-color: var(--color-accent);
    color: var(--color-heading);
    background-color: color-mix(in srgb, var(--color-accent) 5%, transparent);
  }

  .toc-inline summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    color: var(--color-subtle);
    font-size: var(--text-label);
    list-style: none;
    user-select: none;
  }

  .toc-inline summary::-webkit-details-marker {
    display: none;
  }

  .toc-inline summary::marker {
    content: "";
  }

  .toc-inline-label {
    color: var(--color-heading);
    font-weight: 500;
  }

  .toc-inline-count {
    color: var(--color-subtle);
  }

  .toc-chevron {
    width: 0.875rem;
    height: 0.875rem;
    margin-left: auto;
    transition: transform 0.18s ease;
  }

  .toc-inline[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-inline .toc-list {
    margin-top: 0.6rem;
  }

  .toc-inline .toc-item a {
    font-size: 0.8125rem;
  }

  .toc-inline .toc-item-sub a {
    font-size: 0.75rem;
  }
</style>

<script>
  type TocEntry = { link: HTMLAnchorElement; target: HTMLElement };

  let cleanupToc: (() => void) | null = null;

  const initToc = () => {
    cleanupToc?.();
    cleanupToc = null;

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-toc-link]"));
    if (links.length === 0) return;

    const entries = links
      .map((link) => {
        const hash = link.hash.replace(/^#/, "");
        let id = hash;
        try {
          id = decodeURIComponent(hash);
        } catch {}
        const target = id ? document.getElementById(id) : null;
        return target ? { link, target } : null;
      })
      .filter((entry): entry is TocEntry => entry !== null);

    if (entries.length === 0) return;

    let frame = 0;

    const update = () => {
      frame = 0;
      // 以视口上方 30% 左右作为「当前段落」的分界线，标题滚过它就算进入。
      const marker = window.scrollY + Math.min(window.innerHeight * 0.3, 240);
      let active = entries[0].target;
      for (const entry of entries) {
        const top = entry.target.getBoundingClientRect().top + window.scrollY;
        if (top <= marker) active = entry.target;
      }
      for (const entry of entries) {
        if (entry.target === active) entry.link.setAttribute("aria-current", "location");
        else entry.link.removeAttribute("aria-current");
      }
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const inline = document.querySelector<HTMLDetailsElement>("[data-toc-inline]");
    const onInlineClick = (event: Event) => {
      if ((event.target as Element | null)?.closest("a")) inline?.removeAttribute("open");
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    inline?.addEventListener("click", onInlineClick);
    update();

    cleanupToc = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      inline?.removeEventListener("click", onInlineClick);
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    };
  };

  document.addEventListener("astro:page-load", initToc);
  initToc();
</script>
