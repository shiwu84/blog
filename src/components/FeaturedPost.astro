---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import Badge from "./Badge.astro";
import { estimateReadingMinutes, tagPath } from "../utils/content";
import { withBase } from "../utils/withBase";

interface Props {
  post: CollectionEntry<"blog">;
  label?: string;
}

const { post, label } = Astro.props;
const tags = post.data.tags ?? [];
---

<article data-featured-post class="group relative grid min-w-0 gap-2.5 px-cell-x py-4 sm:px-6 sm:py-5">
  <span class="featured-bar" aria-hidden="true"></span>
  <div class="flex items-start justify-between gap-4">
    <h2 class="min-w-0 text-title text-heading">
      <a class="no-underline transition-colors group-hover:text-accent" href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
    </h2>
    <span class="featured-arrow mt-0.5 shrink-0 text-subtle" aria-hidden="true">
      <svg class="size-4.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
  </div>
  <p class="text-[0.9375rem] leading-relaxed text-content">{post.data.description}</p>
  <footer class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1.5">
    {label && <span class="chip">{label}</span>}
    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5" aria-label="文章标签">
        {tags.map((tag) => <li><Badge href={withBase(tagPath(tag))}>{tag}</Badge></li>)}
      </ul>
    )}
    <span class="ml-auto inline-flex flex-wrap items-center gap-1.5 tabular-nums *:chip">
      <FormattedDate date={post.data.pubDate} />
      <span>{estimateReadingMinutes(post.body ?? "")} 分钟</span>
    </span>
  </footer>
</article>

<style>
  .featured-bar {
    position: absolute;
    inset-block: 0.75rem;
    left: 0;
    width: 2px;
    border-radius: 999px;
    background-color: var(--color-accent);
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .group:hover .featured-bar {
    opacity: 1;
  }

  .featured-arrow {
    transition: transform 0.18s ease, color 0.18s ease;
  }

  .group:hover .featured-arrow {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-arrow {
      transition: none;
    }
  }
</style>
