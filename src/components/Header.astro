---
import { NAV_LINKS, SEARCH, SITE_TITLE } from "../consts";
import { isRouteActive, withBase } from "../utils/withBase";
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SearchDialog from "./SearchDialog.astro";

const currentSection = NAV_LINKS.find((link) => isRouteActive(Astro.url.pathname, link.href))?.label ?? "首页";

const navLinkClass = "group flex items-center gap-1.5 rounded-box px-2.5 py-1.5 text-nav text-content transition-colors hover:bg-surface-alt aria-[current=page]:text-accent";
const navDotClass = "size-1 scale-[.45] rounded-full bg-current opacity-0 transition group-aria-[current=page]:scale-100 group-aria-[current=page]:opacity-100";
---

<header data-site-header transition:name="site-header" transition:animate="none" class="group sticky top-0 z-50 border-b border-border bg-surface-alt/85 backdrop-blur-md backdrop-saturate-150">
  <div class="bar-inner h-bar items-center gap-3">
    <p class="flex min-w-0 flex-1 items-baseline gap-2 truncate">
      <a class="text-section text-heading no-underline transition-colors hover:text-accent" href={withBase("/")}>{SITE_TITLE}</a>
      <span aria-hidden="true" class="text-subtle">/</span>
      <span class="current-section truncate text-label text-subtle">{currentSection}</span>
    </p>

    <nav class="hidden md:block" aria-label="主导航">
      <ul class="flex items-center">
        {NAV_LINKS.map((link) => (
          <li>
            <HeaderLink class={navLinkClass} href={link.href}>
              <span>{link.label}</span>
              <span class={navDotClass} aria-hidden="true"></span>
            </HeaderLink>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center">
      {SEARCH.enabled && <SearchDialog />}
      <ThemeToggle />
      <button id="menu-toggle" class="icon-button md:hidden" type="button" aria-label="展开导航" aria-controls="mobile-nav" aria-expanded="false">
        <svg class="size-4.5 fill-none stroke-current stroke-2 group-data-open:hidden" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg class="hidden size-4.5 fill-none stroke-current stroke-2 group-data-open:block" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="pointer-events-none invisible h-0 overflow-hidden border-border opacity-0 group-data-animate:transition-[height,opacity] group-data-animate:duration-200 group-data-animate:ease-out group-data-open:pointer-events-auto group-data-open:visible group-data-open:h-20 group-data-open:border-t group-data-open:opacity-100 md:hidden"
    aria-label="移动端导航"
    aria-hidden="true"
  >
    <div class="bar-inner h-full">
      <ul class="grid h-full w-full grid-cols-2 items-center gap-x-3 gap-y-1">
        {NAV_LINKS.map((link) => (
          <li>
            <HeaderLink class={navLinkClass} href={link.href} tabindex="-1">
              <span>{link.label}</span>
              <span class={navDotClass} aria-hidden="true"></span>
            </HeaderLink>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  [data-site-header][data-scrolled] {
    box-shadow: 0 12px 32px -30px rgba(23, 24, 26, .75);
  }

  /* 菜单展开时，导航项依次淡入上浮；收起时直接淡出。 */
  #mobile-nav ul > li {
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity .16s ease, transform .16s ease;
  }

  [data-site-header][data-open] #mobile-nav ul > li {
    opacity: 1;
    transform: translateY(0);
  }

  [data-site-header][data-open] #mobile-nav ul > li:nth-child(1) { transition-delay: 30ms; }
  [data-site-header][data-open] #mobile-nav ul > li:nth-child(2) { transition-delay: 60ms; }
  [data-site-header][data-open] #mobile-nav ul > li:nth-child(3) { transition-delay: 90ms; }
  [data-site-header][data-open] #mobile-nav ul > li:nth-child(4) { transition-delay: 120ms; }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav ul > li {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script is:inline data-astro-rerun>
  try {
    if (window.matchMedia("(width < 48rem)").matches && sessionStorage.getItem("mobile-nav-open") === "true") {
      document.querySelector("[data-site-header]")?.setAttribute("data-open", "");
    }
  } catch {}
</script>

<script>
  // 换页后重新绑定页头监听，并清理上一页的监听。
  let menuCleanup: (() => void) | null = null;
  document.addEventListener("astro:page-load", () => {
    menuCleanup?.();
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const menuToggle = document.getElementById("menu-toggle");
    const mobileNav = document.getElementById("mobile-nav");
    const menuStorageKey = "mobile-nav-open";
    const mobileViewport = window.matchMedia("(width < 48rem)");
    const readMenuOpen = () => { try { return sessionStorage.getItem(menuStorageKey) === "true"; } catch { return false; } };
    const writeMenuOpen = (open: boolean) => { try { sessionStorage.setItem(menuStorageKey, String(open)); } catch {} };

    const setMenuOpen = (open: boolean, persist = true) => {
      header?.toggleAttribute("data-open", open);
      menuToggle?.setAttribute("aria-expanded", String(open));
      menuToggle?.setAttribute("aria-label", open ? "收起导航" : "展开导航");
      mobileNav?.setAttribute("aria-hidden", String(!open));
      // inert 让收起状态下的链接不可点击、不可聚焦，避免 Tab 进入隐藏菜单
      mobileNav?.toggleAttribute("inert", !open);
      mobileNav?.querySelectorAll("a").forEach((link) => { link.tabIndex = open ? 0 : -1; });
      if (persist) writeMenuOpen(open);
    };

    const closeMenu = () => setMenuOpen(false);

    const syncMenuToViewport = () => setMenuOpen(mobileViewport.matches && readMenuOpen(), false);

    // 滚动后给吸顶栏一点投影，避免和正文糊在一起。
    let scrollFrame = 0;
    const syncScrolled = () => {
      scrollFrame = 0;
      header?.toggleAttribute("data-scrolled", window.scrollY > 4);
    };
    const onScroll = () => {
      if (!scrollFrame) scrollFrame = requestAnimationFrame(syncScrolled);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    syncScrolled();

    menuToggle?.addEventListener("click", () => {
      header?.setAttribute("data-animate", "");
      setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
    });

    // 点击菜单里的导航链接后立即收起，换页后不会再弹开
    const onMobileNavClick = (event: Event) => {
      const target = event.target as Element | null;
      if (target?.closest("a")) {
        closeMenu();
        writeMenuOpen(false);
      }
    };
    mobileNav?.addEventListener("click", onMobileNavClick);

    // 任何站内跳转（logo、页脚、前进后退）开始前都收起菜单
    const onBeforePreparation = () => {
      closeMenu();
      writeMenuOpen(false);
    };
    document.addEventListener("astro:before-preparation", onBeforePreparation);
    window.addEventListener("popstate", onBeforePreparation);

    // 点击菜单外部时关闭
    const onPointerDown = (event: PointerEvent) => {
      if (!header?.hasAttribute("data-open")) return;
      const target = event.target as Element | null;
      if (target?.closest("[data-site-header]")) return;
      closeMenu();
    };
    document.addEventListener("pointerdown", onPointerDown);

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && header?.hasAttribute("data-open")) {
        closeMenu();
        menuToggle?.focus();
      }
    };
    document.addEventListener("keydown", onKeydown);

    mobileViewport.addEventListener("change", syncMenuToViewport);

    menuCleanup = () => {
      document.removeEventListener("astro:before-preparation", onBeforePreparation);
      window.removeEventListener("popstate", onBeforePreparation);
      document.removeEventListener("pointerdown", onPointerDown);
      document.removeEventListener("keydown", onKeydown);
      window.removeEventListener("scroll", onScroll);
      if (scrollFrame) cancelAnimationFrame(scrollFrame);
      scrollFrame = 0;
      mobileViewport.removeEventListener("change", syncMenuToViewport);
      mobileNav?.removeEventListener("click", onMobileNavClick);
    };

    syncMenuToViewport();
  });
</script>
