---
// 回到顶部：滚动超过一屏后出现，尊重「减少动态效果」设置。
---

<button
  type="button"
  data-back-to-top
  class="icon-button fixed right-4 bottom-4 z-40 border border-border bg-surface/90 opacity-0 shadow-sm backdrop-blur-sm transition-[opacity,transform,color,background-color] duration-200 pointer-events-none translate-y-1 data-[visible]:pointer-events-auto data-[visible]:translate-y-0 data-[visible]:opacity-100 sm:right-6 sm:bottom-6"
  aria-label="回到顶部"
  aria-hidden="true"
  tabindex="-1"
>
  <svg class="size-4.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
</button>

<script>
  let cleanupBackToTop: (() => void) | null = null;

  const initBackToTop = () => {
    cleanupBackToTop?.();
    cleanupBackToTop = null;

    const button = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
    if (!button) return;

    let frame = 0;
    const sync = () => {
      frame = 0;
      const visible = window.scrollY > window.innerHeight * 0.8;
      button.toggleAttribute("data-visible", visible);
      button.setAttribute("aria-hidden", String(!visible));
      button.tabIndex = visible ? 0 : -1;
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(sync);
    };

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const onClick = () => {
      window.scrollTo({ top: 0, behavior: reducedMotion.matches ? "auto" : "smooth" });
    };

    button.addEventListener("click", onClick);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    sync();

    cleanupBackToTop = () => {
      button.removeEventListener("click", onClick);
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    };
  };

  document.addEventListener("astro:page-load", initBackToTop);
  initBackToTop();
</script>
