---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import PostList from "./PostList.astro";
import Box from "./layout/Box.astro";
import Cell from "./layout/Cell.astro";
import { withBase } from "../utils/withBase";

interface PostLink {
  id: string;
  title: string;
  pubDate: Date;
}

interface Props {
  pubDate: Date;
  updatedDate?: Date;
  prevPost?: PostLink;
  nextPost?: PostLink;
  relatedPosts?: CollectionEntry<"blog">[];
}

const { pubDate, updatedDate, prevPost, nextPost, relatedPosts = [] } = Astro.props;

const formatDate = (date: Date) => `${date.getFullYear()} 年 ${date.getMonth() + 1} 月 ${date.getDate()} 日`;
const hasAdjacent = Boolean(prevPost || nextPost);
---

<Box as="footer" data-article-footer>
  <Cell class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <span class="article-seal" aria-hidden="true">十五</span>
    <p class="min-w-0 text-body text-subtle">
      写于 <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <span> · 更新于 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>}
      <span aria-hidden="true"> · </span>十五
    </p>
    <a class="chip chip-link ml-auto" href={withBase("/rss.xml")} target="_blank" rel="noopener noreferrer">
      <svg class="size-3 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
        <circle cx="5" cy="19" r="1" />
      </svg>
      RSS 订阅
    </a>
  </Cell>

  {hasAdjacent && (
    <div class="grid divide-y divide-border sm:grid-cols-2 sm:divide-x sm:divide-y-0">
      {prevPost ? (
        <Cell as="a" interactive class="group grid min-w-0 gap-1 no-underline" href={withBase(`/blog/${prevPost.id}/`)}>
          <span class="flex items-center gap-1 text-label text-subtle">
            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            上一篇
          </span>
          <span class="line-clamp-2 text-card text-heading transition-colors group-hover:text-accent">{prevPost.title}</span>
          <FormattedDate class="text-label text-subtle" date={prevPost.pubDate} />
        </Cell>
      ) : (
        <span class="hidden sm:block" aria-hidden="true"></span>
      )}
      {nextPost ? (
        <Cell as="a" interactive class="group grid min-w-0 gap-1 text-right no-underline [&>span]:justify-end" href={withBase(`/blog/${nextPost.id}/`)}>
          <span class="flex items-center gap-1 text-label text-subtle">
            下一篇
            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </span>
          <span class="line-clamp-2 text-card text-heading transition-colors group-hover:text-accent">{nextPost.title}</span>
          <FormattedDate class="text-label text-subtle" date={nextPost.pubDate} />
        </Cell>
      ) : (
        <span class="hidden sm:block" aria-hidden="true"></span>
      )}
    </div>
  )}
</Box>

{relatedPosts.length > 0 && (
  <Box as="section" data-related-posts>
    <Cell as="header" variant="header" class="flex items-baseline justify-between gap-3">
      <h2 class="text-section text-heading">继续阅读</h2>
      <span class="text-label text-subtle">同一专题或标签</span>
    </Cell>
    <PostList posts={relatedPosts} showReadingTime={false} />
  </Box>
)}

<style>
  .article-seal {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tile);
    background-color: color-mix(in srgb, var(--color-surface-alt) 60%, transparent);
    color: var(--color-heading);
    font-family: var(--font-serif);
    font-size: 0.75rem;
    line-height: 1.12;
    letter-spacing: 0.08em;
    writing-mode: vertical-rl;
    user-select: none;
  }
</style>
